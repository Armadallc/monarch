# Supabase (for local tooling; Framer uses its own config for code components)
# Do not commit .env or real keys. Copy to .env and fill in.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: project ref (subdomain before .supabase.co); used with Supabase CLI link
SUPABASE_PROJECT_REF=esbmnympligtknhtkary
# Optional: remote Postgres password (Dashboard → Project Settings → Database) for
# `supabase db push`, `migration list --linked`, `migration repair --linked`, etc.
# Copy this file to `.env`, set the value, then: `set -a && source .env && set +a`
# (or use direnv). Do not commit `.env`.
SUPABASE_DB_PASSWORD=

# DocuSeal ROI signing (Supabase Edge Function secrets — not used in Framer)
# Test vs production: test API keys only see templates created in DocuSeal Test Mode.
# Template 3756335 (ROI v2.2) — use a production API key, OR duplicate the template in
# Test Mode and set DOCUSEAL_ROI_TEMPLATE_ID to that test template id.
DOCUSEAL_API_KEY=
DOCUSEAL_ROI_TEMPLATE_ID=3756335
DOCUSEAL_WEBHOOK_SECRET=
# Optional: custom embed host if not https://docuseal.com
DOCUSEAL_EMBED_HOST=
